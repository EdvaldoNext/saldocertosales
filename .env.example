# Copie para .env.local e preencha. NUNCA commite o .env.local.
# Nenhuma destas variaveis pode usar o prefixo NEXT_PUBLIC_.

# Banco Turso (libSQL). Em desenvolvimento local, pode usar um arquivo: file:./local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# URL publica do app, SEM barra no final. Em producao use HTTPS.
APP_URL=http://localhost:3000

# Segredo longo e aleatorio para assinar o JWT da sessao (ex.: openssl rand -base64 48)
JWT_SECRET=

# Mercado Pago (Checkout Pro)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Recuperacao de senha (opcional). Sem a chave: em dev o link vai para o log do servidor;
# em producao a recuperacao fica indisponivel (503).
RESEND_API_KEY=
EMAIL_FROM="SaldoCerto <nao-responda@seudominio.com>"

# Opcional: e-mails (separados por virgula) que ignoram a trava de assinatura.
ADMIN_EMAILS=

# Opcional, SOMENTE para testes automatizados: troca a base da API do Mercado Pago.
# Deixe vazio em producao (padrao: https://api.mercadopago.com).
MERCADOPAGO_API_URL=
